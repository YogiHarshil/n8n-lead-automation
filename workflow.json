            "id": "webhook-trigger",
            "name": "Webhook - Lead Capture",
            "type": "n8n-nodes-base.webhook",
            "typeVersion": 2,
            "position": [250, 300],
            "webhookId": "lead-capture-webhook"
        },
        {
            "parameters": {
                "jsCode": "// Validate incoming lead data\nconst items = $input.all();\nconst results = [];\n\nfor (const item of items) {\n  // Handle both direct JSON and nested body from webhook\n  const data = item.json?.body ?? item.json;\n  const errors = [];\n  \n  // Check required fields\n  const name = data.name ? String(data.name).trim() : '';\n  const email = data.email ? String(data.email).trim() : '';\n  \n  if (!name) {\n    errors.push('Name is required');\n  }\n  \n  if (!email) {\n    errors.push('Email is required');\n  } else {\n    // Basic email validation\n    const emailRegex = /^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/;\n    if (!emailRegex.test(email)) {\n      errors.push('Invalid email format');\n    }\n  }\n  \n  // Output validated data with validation metadata\n  results.push({\n    json: {\n      name: name,\n      email: email,\n      phone: data.phone ? String(data.phone).trim() : '',\n      company: data.company ? String(data.company).trim() : '',\n      source: data.source ? String(data.source).trim() : 'Website',\n      message: data.message ? String(data.message).trim() : '',\n      utm_source: data.utm_source || '',\n      utm_medium: data.utm_medium || '',\n      utm_campaign: data.utm_campaign || '',\n      _validation: {\n        isValid: errors.length === 0,\n        errors: errors\n      }\n    }\n  });\n}\n\nreturn results;"
            },
            "id": "validate-input",
            "name": "Validate Input",
            "type": "n8n-nodes-base.code",
            "typeVersion": 2,
            "position": [470, 300]
        },
        {
            "parameters": {
                "conditions": {
                    "options": {
                        "caseSensitive": true,
                        "leftValue": "",
                        "typeValidation": "strict"
                    },
                    "conditions": [
                        {
                            "id": "validation-check",
                            "leftValue": "={{ $json._validation.isValid }}",
                            "rightValue": true,
                            "operator": {
                                "type": "boolean",
                                "operation": "equals"
                            }
                        }
                    ],
                    "combinator": "and"
                },
                "options": {}
            },
            "id": "if-valid",
            "name": "IF - Valid Data",
            "type": "n8n-nodes-base.if",
            "typeVersion": 2,
            "position": [690, 300]
        },
        {
            "parameters": {
                "respondWith": "json",
                "responseBody": "={\n  \"status\": \"error\",\n  \"message\": \"Validation failed\",\n  \"errors\": {{ JSON.stringify($json._validation.errors) }}\n}",
                "options": {
                    "responseCode": 400
                }
            },
            "id": "respond-error",
            "name": "Respond - Validation Error",
            "type": "n8n-nodes-base.respondToWebhook",
            "typeVersion": 1,
            "position": [910, 480]
        },
        {
            "parameters": {
                "jsCode": "// Process and enrich lead data\nconst items = $input.all();\nconst results = [];\n\nfor (const item of items) {\n  const data = item.json;\n  \n  // Generate unique lead ID\n  const timestamp = Date.now();\n  const randomPart = Math.random().toString(36).substring(2, 8);\n  const leadId = `lead_${timestamp}_${randomPart}`;\n  \n  // Create processed lead object\n  const processedLead = {\n    leadId: leadId,\n    name: data.name || '',\n    email: (data.email || '').toLowerCase(),\n    source: data.source || 'Website',\n    phone: data.phone || '',\n    company: data.company || '',\n    message: data.message || '',\n    status: 'new',\n    createdAt: new Date().toISOString(),\n    createdDate: new Date().toLocaleDateString('en-US'),\n    createdTime: new Date().toLocaleTimeString('en-US'),\n    utmSource: data.utm_source || '',\n    utmMedium: data.utm_medium || '',\n    utmCampaign: data.utm_campaign || ''\n  };\n  \n  results.push({ json: processedLead });\n}\n\nreturn results;"
            },
